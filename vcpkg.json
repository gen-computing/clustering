{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "clustering-engine",
  "version-semver": "1.0.0",
  "description": "High-performance C++ clustering engine with AVX2 SIMD, interactive GUI, and Python bindings",
  "license": "MIT",
  "dependencies": [
    "eigen3",
    "glfw3",
    "glew",
    {
      "name": "gtest",
      "platform": "!uwp"
    }
  ],
  "features": {
    "python": {
      "description": "Build Python bindings via pybind11",
      "dependencies": [
        "pybind11"
      ]
    }
  },
  "vcpkg-configuration": {
    "overlay-ports": [],
    "registries": []
  }
}
